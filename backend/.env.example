# ==============================================================================
# CompanyOS Backend Environment Configuration
# ==============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/companyos?schema=public"

# Redis Cache & PubSub
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_SECRET="companyos-dev-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="companyos-dev-super-secret-refresh-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Configuration
PORT=4000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Intelligence Layer (Optional OpenAI-Compatible Provider)
# If left blank, CompanyOS operates in deterministic local mode using company knowledge base
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
